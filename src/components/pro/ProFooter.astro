---
// ProFooter — minimal footer for pro.bayshine.net.
// Intentionally separate from the main site Footer. Self-contained for future extraction.
---
<footer class="relative z-30 mt-20 border-t border-bay-slate/15 py-10 px-4">
  <div class="container mx-auto max-w-6xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="flex items-baseline gap-3">
      <span class="font-display font-bold text-bay-white text-base tracking-[0.08em]">BAYSHINE</span>
      <span class="font-mono text-bay-gold text-[10px] uppercase tracking-[0.18em]">Operators</span>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-6 text-sm">
      <span class="text-bay-slate">Land O' Lakes, FL</span>
      <a href="https://bayshine.net" class="text-bay-slate hover:text-bay-bone transition-colors underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">
        bayshine.net
      </a>
    </div>

    <p class="text-bay-slate/60 text-xs">
      © {new Date().getFullYear()} BayShine Detailing
    </p>
  </div>
</footer>
