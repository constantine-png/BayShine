---
// ProHeader — operator-facing nav for pro.bayshine.net.
// Intentionally separate from the main site Header. Self-contained for future extraction.
---
<header class="relative z-30">
  <div class="container mx-auto max-w-6xl px-4 py-5 flex items-center justify-between">
    <a href="/" class="flex items-baseline gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm" aria-label="BayShine Operators home">
      <span class="font-display font-bold text-bay-white text-lg tracking-[0.08em] group-hover:text-bay-bone transition-colors">BAYSHINE</span>
      <span class="font-mono text-bay-gold text-[10px] uppercase tracking-[0.18em]">Operators</span>
    </a>

    <nav class="flex items-center gap-3 sm:gap-6">
      <a href="/about" class="text-bay-slate hover:text-bay-bone text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">About</a>
      <a href="/#standard" class="hidden sm:inline text-bay-slate hover:text-bay-bone text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">The standard</a>
      <a href="/#pay" class="hidden sm:inline text-bay-slate hover:text-bay-bone text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">Pay</a>
      <a href="/#apply" class="btn-sweep gloss-cap bg-bay-gold text-bay-navy font-semibold text-sm px-4 py-2 rounded-sm hover:bg-[#d9bc79] transition-colors whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold focus-visible:ring-offset-2 focus-visible:ring-offset-bay-navy">
        Apply
      </a>
    </nav>
  </div>
</header>
