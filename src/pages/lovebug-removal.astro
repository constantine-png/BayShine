---
// Dedicated Google Ads landing page for "lovebug removal" keyword.
//
// Intentional differences from the rest of the site:
//   - No Header / no Footer / no nav  — fewer exit ramps, standard PPC pattern.
//   - LIGHT brand variant (paper background, ink text) — warmer, more inviting,
//     higher contrast than the navy site for a 65+ audience.
//   - 18px+ body, 56px+ touch targets, single column on mobile.
//   - noindex — never lets Google index this page; the canonical /quote page
//     ranks organically. Avoids Quality Score cannibalization.
//
// Form posts to /api/book with `service: 'Lovebug Removal'` so the lead is
// tagged in the operator inbox.

export const prerender = true;

import '@/styles/global.css';
import SEO from '@/components/ui/SEO.astro';
import LovebugQuickBook from '@/components/islands/LovebugQuickBook';

const exteriorStart = 185;
const fullStart = 255;
const ceramicStart = 750;

const tiers = [
  {
    name: 'Exterior Detail',
    badge: 'Lovebug-focused',
    price: exteriorStart,
    blurb: 'Same-day relief for bug-caked paint.',
    features: [
      'Two-bucket hand wash with bug-safe pre-soak',
      'Hood, grille &amp; bumper bug removal',
      'Clay-bar decontamination',
      'Hand-applied sealant for 3–4 months of slick',
      'Wheel &amp; tire cleaning, glass clarified',
    ],
    cta: 'Most affordable',
    highlight: false,
  },
  {
    name: 'Full Detail',
    badge: 'Most popular',
    price: fullStart,
    blurb: 'Inside and out — like new again.',
    features: [
      'Everything in Exterior Detail',
      'Full interior extraction &amp; steam clean',
      'Leather conditioned, plastics protected',
      'Door jambs, trunk, and floor mats',
      'Final inspection — anything missed gets fixed',
    ],
    cta: 'Best value',
    highlight: true,
  },
  {
    name: 'Ceramic Coating',
    badge: 'Long-term armor',
    price: ceramicStart,
    blurb: 'No more weekly bug battles.',
    features: [
      'Full Exterior Detail prep included',
      '5-year ceramic coating on paint',
      'Bugs, sap &amp; road tar wash off easily',
      'Glossy, hydrophobic finish',
      'Annual maintenance check included',
    ],
    cta: 'Set & forget',
    highlight: false,
  },
];

const faqs = [
  {
    q: 'How fast can you come out?',
    a: 'Most lovebug calls get scheduled same-day or next-day. The acid in lovebug remains starts eating clear coat within 48 hours of baking on hot paint — the sooner the better.',
  },
  {
    q: 'Will the bugs damage my paint permanently?',
    a: 'They will if you leave them. Lovebug guts are acidic. On a hot Florida hood they can etch the clear coat in two or three days, leaving permanent dull spots even after wash. We use a pH-neutral pre-soak that lifts the residue without grinding it into the finish.',
  },
  {
    q: 'Do you come to me?',
    a: 'Yes. I show up to your driveway or workplace and work with whatever your spot has — your hose, your power, your shade. We figure it out together. Service area: all of Pasco County (Land O\' Lakes, Wesley Chapel, Trinity, New Port Richey, Zephyrhills) plus North Hillsborough (Lutz, Carrollwood, north Tampa).',
  },
  {
    q: 'What if it rains?',
    a: 'We reschedule at no charge. Florida rain is part of the deal — we\'d rather move the slot than half-finish a job.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://bayshine.net/lovebug-removal#service',
      name: 'Lovebug Removal — Mobile Auto Detailing',
      description:
        'Same-day mobile lovebug removal and exterior detailing for Pasco County and North Hillsborough, Florida. Hand wash, clay-bar decontamination, sealant. Starting at $185.',
      provider: { '@id': 'https://bayshine.net/#business' },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Pasco County, Florida' },
        { '@type': 'AdministrativeArea', name: 'North Hillsborough County, Florida' },
      ],
      offers: { '@type': 'Offer', priceCurrency: 'USD', price: exteriorStart },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1A1410" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title="Lovebug Removal in Pasco County — Mobile Detail at Your Door | BayShine"
      description="Same-day lovebug removal in Land O' Lakes, Wesley Chapel and the Tampa Bay area. We come to you. Starting at $185. Call (813) 324-5522 or book online."
      schema={schema}
    />
    <style is:global>
      /* Light page override — keeps the rest of the site's dark theme but
         scopes a warm paper background to this landing page only. */
      html.lovebug-page,
      html.lovebug-page body {
        background: var(--color-bay-paper) !important;
        color: var(--color-bay-ink);
      }
      html.lovebug-page body::before,
      html.lovebug-page body::after {
        display: none !important; /* kill the global ambient glow + noise overlay */
      }

      /* Layered photo frame — two offset accent shapes behind the image plus a
         crisp main shadow give a stacked / printed-card feel. */
      .photo-frame {
        position: relative;
        isolation: isolate;
      }
      .photo-frame > .photo-frame-img {
        position: relative;
        z-index: 2;
        border-radius: 1rem;
        box-shadow:
          0 30px 60px -25px rgba(15, 27, 45, 0.45),
          0 8px 18px -10px rgba(15, 27, 45, 0.3),
          0 1px 0 rgba(255, 255, 255, 0.6) inset;
        overflow: hidden;
      }
      .photo-frame::before,
      .photo-frame::after {
        content: '';
        position: absolute;
        border-radius: 1rem;
        z-index: 1;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .photo-frame::before {
        top: -14px;
        right: -14px;
        width: 62%;
        height: 62%;
        background: var(--color-bay-gold);
        opacity: 0.85;
      }
      .photo-frame::after {
        bottom: -14px;
        left: -14px;
        width: 56%;
        height: 56%;
        background: var(--color-bay-ink);
        opacity: 0.92;
      }
      .photo-frame:hover::before { transform: translate(4px, -4px); }
      .photo-frame:hover::after { transform: translate(-4px, 4px); }

      /* Soft paper depth — subtle radial gradient pushes section backgrounds
         off pure flatness without competing with foreground content. */
      .paper-depth {
        background:
          radial-gradient(60% 80% at 90% 10%, rgba(201, 169, 97, 0.12), transparent 70%),
          radial-gradient(50% 70% at 10% 90%, rgba(15, 27, 45, 0.05), transparent 70%),
          var(--color-bay-paper);
      }
      .paper-depth-dark {
        background:
          radial-gradient(70% 100% at 80% 20%, rgba(201, 169, 97, 0.07), transparent 70%),
          radial-gradient(60% 90% at 20% 80%, rgba(201, 169, 97, 0.04), transparent 70%),
          var(--color-bay-ink);
      }

      /* Stronger label color for the cream-bg sections — replaces gold-on-cream
         which read marginal at small sizes. Gold stays for highlights / borders. */
      .label-strong {
        color: var(--color-bay-ink);
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .label-strong::before {
        content: '';
        display: inline-block;
        width: 18px;
        height: 2px;
        background: var(--color-bay-gold);
        vertical-align: middle;
        margin-right: 10px;
        margin-bottom: 3px;
      }

      .glow-cta {
        box-shadow:
          0 12px 32px -10px rgba(201,169,97,0.55),
          0 2px 0 rgba(255,255,255,0.45) inset;
      }

      /* High-contrast CTAs — all inline values, system-font fallbacks, ALL CAPS,
         and an oversized line-height + letter-spacing so the text is unmissable
         regardless of whether Inter Variable has loaded. */
      .cta-primary,
      .cta-secondary,
      .cta-tier {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        font-family: -apple-system, BlinkMacSystemFont, 'Inter Variable', 'Inter',
          'Segoe UI', Roboto, Arial, sans-serif;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        text-align: center;
        line-height: 1.1;
        padding: 22px 28px;
        min-height: 76px;
        border-radius: 8px;
        border: 0;
        cursor: pointer;
        transition: transform 0.1s ease, background-color 0.2s ease;
      }
      .cta-primary {
        background: #000000;
        color: #FFFFFF;
        font-size: clamp(20px, 4.2vw, 26px);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        border-bottom: 5px solid #C9A961;
        box-shadow:
          0 14px 36px -12px rgba(0, 0, 0, 0.5),
          0 1px 0 rgba(255, 255, 255, 0.18) inset;
      }
      .cta-primary:hover {
        background: #1a1410;
      }
      .cta-secondary {
        background: #FFFFFF;
        color: #000000;
        font-size: clamp(18px, 3.8vw, 22px);
        border: 3px solid #000000;
        box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.35);
      }
      .cta-secondary:hover {
        background: #f5f2ec;
      }
      .cta-tier {
        background: #000000;
        color: #FFFFFF;
        font-size: clamp(18px, 3.6vw, 22px);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        border-bottom: 4px solid #C9A961;
        box-shadow: 0 10px 28px -12px rgba(0, 0, 0, 0.45);
      }
      .cta-tier:hover {
        background: #1a1410;
      }
      .cta-primary:active,
      .cta-secondary:active,
      .cta-tier:active {
        transform: scale(0.99);
      }

      /* Lifted headline bubble — gives a spotlighted headline a soft
         white-to-cream card backdrop with stacked drop shadows and a thin
         gold under-stripe inset. Inline-block span around the heading text
         so it hugs the content and lifts off the page. */
      .headline-bubble {
        display: inline-block;
        background: linear-gradient(180deg, #FFFFFF 0%, #FAF7F0 100%);
        padding: 0.4em 0.85em;
        border-radius: 24px;
        color: #000000;
        position: relative;
        box-shadow:
          0 30px 56px -22px rgba(15, 27, 45, 0.34),
          0 12px 22px -10px rgba(15, 27, 45, 0.2),
          0 2px 0 rgba(255, 255, 255, 1) inset,
          0 -6px 0 rgba(201, 169, 97, 0.6) inset,
          0 0 0 1px rgba(15, 27, 45, 0.08);
      }
      .headline-bubble-sm {
        display: inline-block;
        background: linear-gradient(180deg, #FFFFFF 0%, #FAF7F0 100%);
        padding: 0.4em 1.05em;
        border-radius: 999px;
        color: #000000;
        box-shadow:
          0 18px 34px -14px rgba(15, 27, 45, 0.3),
          0 6px 14px -6px rgba(15, 27, 45, 0.18),
          0 1px 0 rgba(255, 255, 255, 1) inset,
          0 -3px 0 rgba(201, 169, 97, 0.65) inset,
          0 0 0 1px rgba(15, 27, 45, 0.08);
      }
      /* Dark-section variant — heavier shadow so it pops against the booking
         section's near-black background. */
      .headline-bubble-dark {
        display: inline-block;
        background: linear-gradient(180deg, #FFFFFF 0%, #F8F4ED 100%);
        padding: 0.5em 1em;
        border-radius: 22px;
        color: #000000;
        box-shadow:
          0 32px 60px -24px rgba(0, 0, 0, 0.65),
          0 14px 26px -10px rgba(0, 0, 0, 0.45),
          0 2px 0 rgba(255, 255, 255, 1) inset,
          0 -5px 0 rgba(201, 169, 97, 0.75) inset,
          0 0 0 1px rgba(15, 27, 45, 0.1);
      }

      /* Sticky mobile bar buttons — same style, more compact for thumb reach. */
      .cta-sticky-primary,
      .cta-sticky-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-family: -apple-system, BlinkMacSystemFont, 'Inter Variable', 'Inter',
          'Segoe UI', Roboto, Arial, sans-serif;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        font-size: 18px;
        line-height: 1.1;
        min-height: 60px;
        padding: 12px 16px;
        border-radius: 8px;
      }
      .cta-sticky-primary {
        background: #000000;
        color: #FFFFFF;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        border-bottom: 4px solid #C9A961;
      }
      .cta-sticky-secondary {
        background: #FFFFFF;
        color: #000000;
        border: 3px solid #000000;
      }
    </style>
    <script is:inline>
      // Ensure the html element has the lovebug-page class on load and reload
      document.documentElement.classList.add('lovebug-page');
    </script>
  </head>
  <body class="lovebug-page">
    <main id="main-content">

      <!-- ── BRAND BAR ──────────────────────────────────────────────── -->
      <div class="bg-bay-ink border-b border-bay-gold/25 relative">
        <!-- thin gold accent stripe under the bar for layered depth -->
        <div class="absolute inset-x-0 -bottom-px h-px bg-gradient-to-r from-transparent via-bay-gold/60 to-transparent" aria-hidden="true"></div>

        <div class="container mx-auto max-w-6xl px-5 sm:px-8 py-4 flex items-center justify-between">
          <a href="/" class="flex items-center gap-2.5" aria-label="BayShine Detailing">
            <img
              src="/assets/logo/bayshine_logo_vector.png"
              alt=""
              width="120"
              height="36"
              class="h-9 w-auto"
            />
          </a>
          <a
            href="tel:+18133245522"
            class="inline-flex items-center gap-2 text-white font-bold text-base sm:text-lg hover:text-bay-gold transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
            </svg>
            <span class="hidden sm:inline">(813) 324-5522</span>
            <span class="sm:hidden">Call us</span>
          </a>
        </div>
      </div>

      <!-- ── HERO ───────────────────────────────────────────────────── -->
      <section class="paper-depth relative overflow-hidden">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8 pt-14 pb-20 sm:pt-20 sm:pb-28 relative">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

            <!-- Left: copy + CTAs -->
            <div class="lg:col-span-7">
              <p class="inline-block bg-bay-ink text-white text-sm font-bold uppercase tracking-[0.18em] px-4 py-2 rounded-full mb-6">
                Same-day · Pasco &amp; N. Hillsborough
              </p>

              <h1 class="font-display font-bold text-[2.6rem] sm:text-6xl lg:text-7xl leading-[1.18] tracking-tight mb-6">
                <span class="headline-bubble">
                  Lovebugs off your car.
                  <span class="text-bay-gold drop-shadow-[0_2px_0_rgba(15,27,45,0.18)]">Today.</span>
                </span>
              </h1>

              <p class="text-bay-ink text-xl sm:text-2xl leading-relaxed max-w-2xl mb-8 font-semibold">
                I show up to your driveway. Bugs off, paint sealed, finished in 2 hours. Starting at
                <span class="font-sans font-black text-bay-ink">$185</span>.
              </p>

              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                <a href="#book" class="cta-primary">
                  Get My Car Cleaned →
                </a>
                <a href="tel:+18133245522" class="cta-secondary">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
                  </svg>
                  Call (813) 324-5522
                </a>
              </div>

              <!-- Trust strip -->
              <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-10 text-bay-ink text-base font-bold">
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold text-xl" aria-hidden="true">✓</span> Mobile — we come to you
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold text-xl" aria-hidden="true">✓</span> 2-hour callback
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold text-xl" aria-hidden="true">✓</span> Owner runs every job
                </li>
              </ul>
            </div>

            <!-- Right: real lovebug photo with layered backdrop -->
            <div class="lg:col-span-5">
              <figure class="photo-frame max-w-[480px] mx-auto">
                <div class="photo-frame-img aspect-[4/3] bg-bay-ink/5">
                  <img
                    src="/assets/lovebugs/bumper.png"
                    alt="Front bumper of a car covered in dead lovebugs — what we wash off"
                    width="894"
                    height="671"
                    loading="eager"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
                <figcaption class="relative z-10 mt-6 text-center text-base font-bold tracking-wide">
                  <span class="headline-bubble-sm">
                    What's eating your paint right now.
                  </span>
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- ── MEET CONSTANTINE ────────────────────────────────────────── -->
      <section class="bg-bay-paper border-t border-bay-ink/8 relative overflow-hidden">
        <!-- subtle layered backdrop accents -->
        <div class="absolute -top-20 -left-32 w-96 h-96 rounded-full bg-bay-gold/8 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -bottom-24 right-0 w-[28rem] h-[28rem] rounded-full bg-bay-ink/[0.04] blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="container mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 relative">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

            <!-- Left: owner photo -->
            <div class="lg:col-span-5">
              <figure class="photo-frame max-w-[420px] mx-auto lg:mx-0">
                <div class="photo-frame-img aspect-[4/5] bg-bay-ink/5">
                  <img
                    src="/assets/team/constantine.jpg"
                    alt="Constantine, owner of BayShine Detailing, in front of a customer's vehicle in Pasco County"
                    width="800"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              </figure>
            </div>

            <!-- Right: bio + commitment -->
            <div class="lg:col-span-7">
              <p class="label-strong text-sm mb-4">Meet your detailer</p>
              <h2 class="font-display font-bold text-4xl sm:text-5xl leading-[1.2] tracking-tight mb-6">
                <span class="headline-bubble">
                  I'm Constantine. The one calling you back.
                </span>
              </h2>
              <p class="text-bay-ink text-lg sm:text-xl leading-relaxed mb-5 font-semibold">
                I own BayShine. I take the call, I wash the car, and I'm the one walking you around it when it's done. You're not getting a call center, a subcontractor, or a teenager with a sponge.
              </p>
              <p class="text-bay-ink text-base sm:text-lg leading-relaxed mb-8 font-medium">
                Two-bucket wash, pH-balanced bug solvent, hand-applied sealant. Every car gets the same attention — yours included.
              </p>

              <div class="inline-flex items-start gap-3 bg-white rounded-xl border-2 border-bay-ink/15 px-5 py-4 shadow-[0_8px_24px_-16px_rgba(15,27,45,0.3)]">
                <div class="w-10 h-10 rounded-full bg-bay-gold/25 flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-bay-ink">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </div>
                <div>
                  <p class="text-bay-ink font-sans font-black text-lg leading-tight">
                    Personal callback within 2 hours.
                  </p>
                  <p class="text-bay-ink text-base mt-1 font-medium">
                    Not an AI. Not a voicemail tag. Me, on the phone.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── PRICING PANEL ──────────────────────────────────────────── -->
      <section id="pricing" class="py-16 sm:py-24 bg-white border-t border-bay-ink/8">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8">

          <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
            <p class="label-strong text-sm mb-4 inline-block">
              Three ways to fix it
            </p>
            <h2 class="font-display font-bold text-4xl sm:text-5xl text-bay-ink mb-4 leading-tight tracking-tight">
              Pick the level of fix you need.
            </h2>
            <p class="text-bay-ink text-lg font-semibold">
              Real prices. No bait-and-switch. Mobile to your driveway in Pasco County and North Hillsborough.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-5">
            {tiers.map((tier) => (
              <article
                class={`relative rounded-2xl bg-white border-2 p-8 flex flex-col ${
                  tier.highlight
                    ? 'border-bay-gold shadow-[0_30px_60px_-25px_rgba(201,169,97,0.45)] md:scale-[1.04]'
                    : 'border-bay-ink/10 shadow-[0_16px_40px_-24px_rgba(15,27,45,0.25)]'
                }`}
              >
                {tier.highlight && (
                  <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-bay-gold text-bay-navy text-xs font-bold uppercase tracking-[0.16em] px-4 py-1.5 rounded-full whitespace-nowrap">
                    {tier.badge}
                  </span>
                )}
                {!tier.highlight && (
                  <p class="text-bay-ink text-sm font-black uppercase tracking-[0.16em] mb-2 inline-flex items-center gap-2">
                    <span class="inline-block w-3 h-0.5 bg-bay-gold"></span>
                    {tier.badge}
                  </p>
                )}
                <h3 class="font-display font-bold text-2xl text-bay-ink mb-2">{tier.name}</h3>
                <p class="text-bay-ink text-base mb-5 font-semibold">{tier.blurb}</p>

                <div class="mb-6">
                  <p class="text-bay-ink text-xs font-black uppercase tracking-widest mb-1">Starting at</p>
                  <p class="font-display font-bold text-bay-ink text-5xl leading-none">
                    ${tier.price}
