                </div>

                <ul class="space-y-3 mb-8 flex-1">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-3 text-bay-ink text-base leading-relaxed font-semibold">
                      <span class="text-bay-gold flex-shrink-0 mt-0.5" aria-hidden="true">
