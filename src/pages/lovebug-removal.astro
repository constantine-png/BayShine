---
// Dedicated Google Ads landing page for "lovebug removal" keyword.
//
// Intentional differences from the rest of the site:
//   - No Header / no Footer / no nav  — fewer exit ramps, standard PPC pattern.
//   - LIGHT brand variant (paper background, ink text) — warmer, more inviting,
//     higher contrast than the navy site for a 65+ audience.
//   - 18px+ body, 56px+ touch targets, single column on mobile.
//   - noindex — never lets Google index this page; the canonical /quote page
//     ranks organically. Avoids Quality Score cannibalization.
//
// Form posts to /api/book with `service: 'Lovebug Removal'` so the lead is
// tagged in the operator inbox.

export const prerender = true;

import '@/styles/global.css';
import SEO from '@/components/ui/SEO.astro';
import LovebugQuickBook from '@/components/islands/LovebugQuickBook';

const exteriorStart = 185;
const fullStart = 255;
const ceramicStart = 750;

const tiers = [
  {
    name: 'Exterior Detail',
    badge: 'Lovebug-focused',
    price: exteriorStart,
    blurb: 'Same-day relief for bug-caked paint.',
    features: [
      'Two-bucket hand wash with bug-safe pre-soak',
      'Hood, grille &amp; bumper bug removal',
      'Clay-bar decontamination',
      'Hand-applied sealant for 3–4 months of slick',
      'Wheel &amp; tire cleaning, glass clarified',
    ],
    cta: 'Most affordable',
    highlight: false,
  },
  {
    name: 'Full Detail',
    badge: 'Most popular',
    price: fullStart,
    blurb: 'Inside and out — like new again.',
    features: [
      'Everything in Exterior Detail',
      'Full interior extraction &amp; steam clean',
      'Leather conditioned, plastics protected',
      'Door jambs, trunk, and floor mats',
      'Final inspection — anything missed gets fixed',
    ],
    cta: 'Best value',
    highlight: true,
  },
  {
    name: 'Ceramic Coating',
    badge: 'Long-term armor',
    price: ceramicStart,
    blurb: 'No more weekly bug battles.',
    features: [
      'Full Exterior Detail prep included',
      '5-year ceramic coating on paint',
      'Bugs, sap &amp; road tar wash off easily',
      'Glossy, hydrophobic finish',
      'Annual maintenance check included',
    ],
    cta: 'Set & forget',
    highlight: false,
  },
];

const faqs = [
  {
    q: 'How fast can you come out?',
    a: 'Most lovebug calls get scheduled same-day or next-day. The acid in lovebug remains starts eating clear coat within 48 hours of baking on hot paint — the sooner the better.',
  },
  {
    q: 'Will the bugs damage my paint permanently?',
    a: 'They will if you leave them. Lovebug guts are acidic. On a hot Florida hood they can etch the clear coat in two or three days, leaving permanent dull spots even after wash. We use a pH-neutral pre-soak that lifts the residue without grinding it into the finish.',
  },
  {
    q: 'Do you come to me?',
    a: 'Yes. We bring water, power, and everything we need to your driveway or workplace. No need to drop the car off. Service area: all of Pasco County (Land O\' Lakes, Wesley Chapel, Trinity, New Port Richey, Zephyrhills) plus North Hillsborough (Lutz, Carrollwood, north Tampa).',
  },
  {
    q: 'What if it rains?',
    a: 'We reschedule at no charge. Florida rain is part of the deal — we\'d rather move the slot than half-finish a job.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://bayshine.net/lovebug-removal#service',
      name: 'Lovebug Removal — Mobile Auto Detailing',
      description:
        'Same-day mobile lovebug removal and exterior detailing for Pasco County and North Hillsborough, Florida. Hand wash, clay-bar decontamination, sealant. Starting at $185.',
      provider: { '@id': 'https://bayshine.net/#business' },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Pasco County, Florida' },
        { '@type': 'AdministrativeArea', name: 'North Hillsborough County, Florida' },
      ],
      offers: { '@type': 'Offer', priceCurrency: 'USD', price: exteriorStart },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8F4ED" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title="Lovebug Removal in Pasco County — Mobile Detail at Your Door | BayShine"
      description="Same-day lovebug removal in Land O' Lakes, Wesley Chapel and the Tampa Bay area. We come to you. Starting at $185. Call (813) 324-5522 or book online."
      schema={schema}
    />
    <style is:global>
      /* Light page override — keeps the rest of the site's dark theme but
         scopes a warm paper background to this landing page only. */
      html.lovebug-page,
      html.lovebug-page body {
        background: var(--color-bay-paper) !important;
        color: var(--color-bay-ink);
      }
      html.lovebug-page body::before,
      html.lovebug-page body::after {
        display: none !important; /* kill the global ambient glow + noise overlay */
      }

      /* Bug-splatter backdrop for the hero — abstract, evocative, no real photo
         needed for v1. Replace with a real grille shot in PhotoSlot when ready. */
      .bug-splatter {
        background-image:
          radial-gradient(circle at 18% 22%, rgba(15,27,45,0.10) 0 3px, transparent 4px),
          radial-gradient(circle at 72% 14%, rgba(15,27,45,0.12) 0 4px, transparent 5px),
          radial-gradient(circle at 34% 64%, rgba(15,27,45,0.10) 0 5px, transparent 6px),
          radial-gradient(circle at 85% 42%, rgba(15,27,45,0.08) 0 2px, transparent 3px),
          radial-gradient(circle at 12% 78%, rgba(15,27,45,0.10) 0 3px, transparent 4px),
          radial-gradient(circle at 56% 88%, rgba(15,27,45,0.11) 0 4px, transparent 5px),
          radial-gradient(circle at 47% 30%, rgba(15,27,45,0.07) 0 2px, transparent 3px),
          radial-gradient(circle at 88% 78%, rgba(15,27,45,0.09) 0 3px, transparent 4px);
        background-color: var(--color-bay-paper);
      }

      .glow-cta {
        box-shadow:
          0 12px 32px -10px rgba(201,169,97,0.55),
          0 2px 0 rgba(255,255,255,0.45) inset;
      }
    </style>
    <script is:inline>
      // Ensure the html element has the lovebug-page class on load and reload
      document.documentElement.classList.add('lovebug-page');
    </script>
  </head>
  <body class="lovebug-page">
    <main id="main-content">

      <!-- ── BRAND BAR ──────────────────────────────────────────────── -->
      <div class="border-b border-bay-ink/10 bg-white/60 backdrop-blur-sm">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8 py-4 flex items-center justify-between">
          <a href="/" class="flex items-center gap-2.5" aria-label="BayShine Detailing">
            <img
              src="/assets/logo/bayshine_logo_vector.png"
              alt=""
              width="120"
              height="36"
              class="h-9 w-auto"
            />
          </a>
          <a
            href="tel:+18133245522"
            class="inline-flex items-center gap-2 text-bay-ink font-bold text-base sm:text-lg hover:text-bay-gold transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
            </svg>
            <span class="hidden sm:inline">(813) 324-5522</span>
            <span class="sm:hidden">Call us</span>
          </a>
        </div>
      </div>

      <!-- ── HERO ───────────────────────────────────────────────────── -->
      <section class="bug-splatter relative overflow-hidden">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8 pt-14 pb-20 sm:pt-20 sm:pb-28 relative">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

            <!-- Left: copy + CTAs -->
            <div class="lg:col-span-7">
              <p class="inline-block bg-bay-gold/15 text-bay-ink text-xs sm:text-sm font-bold uppercase tracking-[0.18em] px-3 py-1.5 rounded-full mb-6">
                Same-day · Pasco &amp; N. Hillsborough
              </p>

              <h1 class="font-display font-bold text-[2.5rem] sm:text-6xl lg:text-7xl text-bay-ink leading-[1.05] tracking-tight mb-6">
                Lovebugs off your car.
                <span class="text-bay-gold">Today.</span>
              </h1>

              <p class="text-bay-ink/75 text-xl sm:text-2xl leading-relaxed max-w-2xl mb-8">
                We come to your driveway with everything we need. Bugs off, paint sealed, finished in 2 hours. Starting at
                <span class="font-display font-bold text-bay-ink">$185</span>.
              </p>

              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                <a
                  href="#book"
                  class="glow-cta inline-flex items-center justify-center bg-bay-gold text-bay-navy font-display font-bold text-lg sm:text-xl px-8 py-5 min-h-[64px] rounded-md hover:bg-[#d9bc79] active:scale-[0.99] transition-all focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bay-gold/40"
                >
                  Get my truck cleaned →
                </a>
                <a
                  href="tel:+18133245522"
                  class="inline-flex items-center justify-center gap-2 bg-white border-2 border-bay-ink/15 text-bay-ink font-display font-bold text-lg px-8 py-5 min-h-[64px] rounded-md hover:border-bay-ink/40 active:scale-[0.99] transition-all"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
                  </svg>
                  Call (813) 324-5522
                </a>
              </div>

              <!-- Trust strip -->
              <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-10 text-bay-ink/65 text-sm">
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold" aria-hidden="true">✓</span> Mobile — we come to you
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold" aria-hidden="true">✓</span> 2-hour callback
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-bay-gold" aria-hidden="true">✓</span> Licensed &amp; insured
                </li>
              </ul>
            </div>

            <!-- Right: hero photo slot -->
            <div class="lg:col-span-5">
              <div
                class="rounded-2xl bg-white border-2 border-dashed border-bay-ink/15 aspect-[4/5] flex flex-col items-center justify-center p-8 text-center"
                data-photo-needed="Front end / grille of a Florida car visibly covered in lovebug residue — closeup, golden-hour light, paint partially clean to show before/after"
                role="img"
                aria-label="Photo needed: lovebug-covered front end"
              >
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-bay-ink/30 mb-4" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
                <p class="text-bay-ink/55 font-mono text-xs leading-relaxed max-w-[220px]">
                  Front-end / grille closeup of a Florida car covered in lovebugs — Constantine swaps a real shot in.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── PRICING PANEL ──────────────────────────────────────────── -->
      <section id="pricing" class="py-16 sm:py-24">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8">

          <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
            <p class="text-bay-gold text-xs sm:text-sm font-bold uppercase tracking-[0.18em] mb-3">
              Three ways to fix it
            </p>
            <h2 class="font-display font-bold text-4xl sm:text-5xl text-bay-ink mb-4 leading-tight tracking-tight">
              Pick the level of fix you need.
            </h2>
            <p class="text-bay-ink/70 text-lg">
              Real prices. No bait-and-switch. Mobile to your driveway in Pasco County and North Hillsborough.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-5">
            {tiers.map((tier) => (
              <article
                class={`relative rounded-2xl bg-white border-2 p-8 flex flex-col ${
                  tier.highlight
                    ? 'border-bay-gold shadow-[0_30px_60px_-25px_rgba(201,169,97,0.45)] md:scale-[1.04]'
                    : 'border-bay-ink/10 shadow-[0_16px_40px_-24px_rgba(15,27,45,0.25)]'
                }`}
              >
                {tier.highlight && (
                  <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-bay-gold text-bay-navy text-xs font-bold uppercase tracking-[0.16em] px-4 py-1.5 rounded-full whitespace-nowrap">
                    {tier.badge}
                  </span>
                )}
                {!tier.highlight && (
                  <p class="text-bay-gold text-xs font-bold uppercase tracking-[0.16em] mb-2">
                    {tier.badge}
                  </p>
                )}
                <h3 class="font-display font-bold text-2xl text-bay-ink mb-2">{tier.name}</h3>
                <p class="text-bay-ink/65 text-base mb-5">{tier.blurb}</p>

                <div class="mb-6">
                  <p class="text-bay-ink/55 text-xs font-bold uppercase tracking-widest mb-1">Starting at</p>
                  <p class="font-display font-bold text-bay-ink text-5xl leading-none">
                    ${tier.price}
                  </p>
                </div>

                <ul class="space-y-3 mb-8 flex-1">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-3 text-bay-ink/85 text-base leading-relaxed">
                      <span class="text-bay-gold flex-shrink-0 mt-0.5" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      </span>
                      <span set:html={f}></span>
                    </li>
                  ))}
                </ul>

                <a
                  href="#book"
                  class={`block text-center font-display font-bold text-base sm:text-lg px-6 py-4 min-h-[56px] rounded-md transition-all ${
                    tier.highlight
                      ? 'glow-cta bg-bay-gold text-bay-navy hover:bg-[#d9bc79]'
                      : 'bg-bay-ink text-white hover:bg-bay-ink/85'
                  }`}
                >
                  Choose {tier.name}
                </a>
              </article>
            ))}
          </div>

          <p class="text-center text-bay-ink/55 text-sm mt-10">
            Final price confirmed in person — set by vehicle size and condition.
          </p>
        </div>
      </section>

      <!-- ── BOOKING FORM ───────────────────────────────────────────── -->
      <section id="book" class="bg-bay-ink py-20 sm:py-28">
        <div class="container mx-auto max-w-3xl px-5 sm:px-8">
          <div class="text-center mb-10">
            <p class="text-bay-gold text-xs sm:text-sm font-bold uppercase tracking-[0.18em] mb-3">
              Book in 60 seconds
            </p>
            <h2 class="font-display font-bold text-4xl sm:text-5xl text-white mb-4 leading-tight tracking-tight">
              Tell us about your car.
            </h2>
            <p class="text-white/70 text-lg max-w-xl mx-auto">
              We'll call you back within 2 hours with the exact price and the next available slot.
            </p>
          </div>

          <LovebugQuickBook client:load />
        </div>
      </section>

      <!-- ── FAQ ────────────────────────────────────────────────────── -->
      <section class="py-16 sm:py-24">
        <div class="container mx-auto max-w-3xl px-5 sm:px-8">
          <h2 class="font-display font-bold text-3xl sm:text-4xl text-bay-ink mb-10 text-center tracking-tight">
            Quick questions answered.
          </h2>
          <dl class="space-y-5">
            {faqs.map((item) => (
              <details class="group bg-white border border-bay-ink/10 rounded-2xl px-6 py-5 shadow-[0_8px_24px_-18px_rgba(15,27,45,0.3)]">
                <summary class="cursor-pointer list-none flex items-start justify-between gap-4 text-bay-ink font-semibold text-lg sm:text-xl">
                  <span>{item.q}</span>
                  <span class="flex-shrink-0 text-bay-gold transition-transform group-open:rotate-45 text-2xl leading-none font-light" aria-hidden="true">+</span>
                </summary>
                <p class="text-bay-ink/75 text-base sm:text-lg leading-relaxed mt-4">
                  {item.a}
                </p>
              </details>
            ))}
          </dl>
        </div>
      </section>

      <!-- ── FOOTER ─────────────────────────────────────────────────── -->
      <footer class="bg-bay-paper border-t border-bay-ink/10 py-10">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-bay-ink/55 text-sm text-center sm:text-left">
            BayShine Detailing · Pasco County, FL · Licensed &amp; insured
          </p>
          <a href="tel:+18133245522" class="font-mono font-bold text-bay-ink text-base hover:text-bay-gold">
            (813) 324-5522
          </a>
        </div>
      </footer>
    </main>

    <!-- ── STICKY MOBILE CTA BAR ──────────────────────────────────── -->
    <div class="fixed inset-x-0 bottom-0 z-50 md:hidden bg-white/95 backdrop-blur-md border-t-2 border-bay-gold/30 px-4 py-3 shadow-[0_-12px_32px_-12px_rgba(15,27,45,0.25)]">
      <div class="flex gap-3 max-w-md mx-auto">
        <a
          href="tel:+18133245522"
          class="flex-1 inline-flex items-center justify-center gap-2 bg-white border-2 border-bay-ink/15 text-bay-ink font-display font-bold text-base px-3 py-3 min-h-[52px] rounded-md"
          aria-label="Call BayShine Detailing"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
          </svg>
          Call
        </a>
        <a
          href="#book"
          class="flex-[1.4] glow-cta inline-flex items-center justify-center bg-bay-gold text-bay-navy font-display font-bold text-base px-3 py-3 min-h-[52px] rounded-md"
        >
          Book Now →
        </a>
      </div>
    </div>

    <!-- Smooth scroll for #book CTAs -->
    <script>
      document.querySelectorAll('a[href="#book"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const target = document.getElementById('book');
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // focus the form for screen readers
            setTimeout(() => {
              const firstInput = target.querySelector('select, input') as HTMLElement | null;
              firstInput?.focus({ preventScroll: true });
            }, 600);
          }
        });
      });
    </script>
  </body>
</html>
