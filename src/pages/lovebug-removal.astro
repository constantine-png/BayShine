                  ))}
                </ul>

                <a href="#book" class="cta-tier">
                  Choose {tier.name}
                </a>
              </article>
            ))}
          </div>

          <p class="text-center text-bay-ink text-base mt-10 font-semibold">
            Final price confirmed in person — set by vehicle size and condition.
          </p>
        </div>
      </section>

      <!-- ── WHAT HAPPENS NEXT ──────────────────────────────────────── -->
      <section class="paper-depth border-t border-bay-ink/8 py-14 sm:py-20">
