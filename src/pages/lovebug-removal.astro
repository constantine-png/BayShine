    <!-- ── STICKY MOBILE CTA BAR ──────────────────────────────────── -->
    <div class="fixed inset-x-0 bottom-0 z-50 md:hidden bg-white/98 backdrop-blur-md border-t-2 border-bay-ink/40 px-4 py-3 shadow-[0_-12px_32px_-12px_rgba(15,27,45,0.25)]">
      <div class="flex gap-3 max-w-md mx-auto">
        <a href="tel:+18133245522" class="cta-sticky-secondary flex-1" aria-label="Call BayShine Detailing">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 18.92z"/>
          </svg>
          Call
        </a>
        <a href="#book" class="cta-sticky-primary flex-[1.4]">
          Book Now →
        </a>
      </div>
    </div>

    <!-- Smooth scroll for #book CTAs -->
    <script>
      document.querySelectorAll('a[href="#book"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const target = document.getElementById('book');
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // focus the form for screen readers
            setTimeout(() => {
              const firstInput = target.querySelector('select, input') as HTMLElement | null;
              firstInput?.focus({ preventScroll: true });
            }, 600);
          }
        });
      });
    </script>
