      <!-- ── FOOTER ─────────────────────────────────────────────────── -->
      <footer class="bg-bay-paper border-t border-bay-ink/15 py-10">
        <div class="container mx-auto max-w-6xl px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-bay-ink text-base text-center sm:text-left font-semibold">
            BayShine Detailing · Pasco County, FL · Owner-run
