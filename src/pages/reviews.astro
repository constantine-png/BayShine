---
// /reviews — dedicated reviews destination, mirroring the Merry Maids local
// franchise pattern. Aggregated reviews via Featurable widget when configured,
// FAQ interleaved for crawler depth and to answer real prospect hesitation,
// repeated phone CTA, schema for FAQPage and BreadcrumbList. No AggregateRating
// block until verified review counts are known: invented social proof violates
// the no-invented-data rule.
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Divider from '@/components/ui/Divider.astro';
import { FAQS } from '@/data/faq';

const featurableId = import.meta.env.FEATURABLE_WIDGET_ID;

// Hand-picked subset of the canonical FAQ list relevant to a reviews-page reader:
// the questions a prospect has after reading other people's experiences.
const reviewsRelevantFaqs = FAQS.filter(f =>
  [
    'Do you come to me, or do I bring the vehicle somewhere?',
    'How long does a full detail take?',
    'What if the result is not what I expected?',
    'What is the Standing Detail program?',
  ].includes(f.question)
);

// Reviews-page-specific questions that don't fit on the homepage FAQ but matter here.
const reviewsPageFaqs = [
  {
    question: 'Where do these reviews come from?',
    answer:
      'Reviews are pulled from real customers who booked service through BayShine. The aggregation widget loads them directly from the review source so the page reflects current standing, not curated snapshots.',
  },
  {
    question: 'How does BayShine handle a negative review?',
    answer:
      'Direct. If a result missed the standard, the answer is to come back and fix it at no charge before any review conversation happens. If the review is already posted, we respond on the platform with the actual sequence of what happened and what we did about it. No deflection, no template replies.',
  },
  {
    question: 'How do I leave a review after my service?',
    answer:
      'After your appointment we send a short follow-up with a direct link to the review platform. If you want to leave one without waiting, search BayShine Detailing on Google and use the Write a Review button on the business profile.',
  },
];

const allFaqs = [...reviewsRelevantFaqs, ...reviewsPageFaqs];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    // FOLLOWUP: src/pages/reviews.astro — Add AggregateRating block once a
    // verified review count and average rating from Google Business Profile
    // are known. Format:
    // {
    //   '@type': 'AggregateRating',
    //   '@id': 'https://bayshine.net/#aggregateRating',
    //   itemReviewed: { '@id': 'https://bayshine.net/#business' },
    //   ratingValue: '5.0',     // real number from GBP
    //   reviewCount: 0,          // real count from GBP
    //   bestRating: '5',
    //   worstRating: '1',
    // }
    {
      '@type': 'WebPage',
      '@id': 'https://bayshine.net/reviews#webpage',
      url: 'https://bayshine.net/reviews',
      name: 'Customer Reviews | BayShine Detailing',
      description:
        'Customer reviews for BayShine Detailing, mobile auto detailing in Pasco County and North Hillsborough, FL.',
      isPartOf: { '@id': 'https://bayshine.net/#business' },
      breadcrumb: { '@id': 'https://bayshine.net/reviews#breadcrumbs' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://bayshine.net/reviews#breadcrumbs',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bayshine.net' },
        { '@type': 'ListItem', position: 2, name: 'Reviews', item: 'https://bayshine.net/reviews' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: allFaqs.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---
<BaseLayout
  title="Customer Reviews | BayShine Mobile Detailing | Pasco County"
  description="Real customer reviews for BayShine Detailing. Mobile auto detailing serving Pasco County and North Hillsborough, FL. Read what clients say about the Standing Detail program and one-time service."
  schema={schema}
>

  <!-- ── HERO ───────────────────────────────────────────────── -->
  <section class="noise-overlay py-24 px-4">
    <div class="container mx-auto max-w-3xl">
      <div class="reveal">
        <p class="text-bay-gold text-xs font-semibold uppercase tracking-widest mb-4">Customer Reviews</p>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-bay-white leading-[1.08] mb-6 tracking-tight" style="text-shadow: 0 2px 24px rgba(15,27,45,0.7);">
          What clients say<br />about the work.
        </h1>
        <p class="text-bay-slate text-lg leading-relaxed mb-10 max-w-2xl">
          Direct reviews from clients in Land O' Lakes, Wesley Chapel, Lutz, and
          across Pasco County and North Hillsborough. Pulled from the review
          source as they post, not hand-picked.
        </p>
        <div class="flex flex-wrap gap-4 items-center">
          <Button href="/contact" variant="primary" class="text-base px-8 py-3.5">
            Book Now
          </Button>
          <a
            href="tel:+18133245522"
            class="inline-flex items-center gap-2 text-bay-gold font-display font-semibold text-base hover:text-[#d9bc79] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 13.5 19.79 19.79 0 0 1 1.07 4.9 2 2 0 0 1 3.05 2.74h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 18z"/>
            </svg>
            (813) 324-5522
          </a>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ── REVIEWS WIDGET ────────────────────────────────────── -->
  <section class="py-16 px-4" aria-labelledby="reviews-heading">
    <div class="container mx-auto max-w-5xl">
      <div class="reveal mb-10">
        <h2 id="reviews-heading" class="font-display font-bold text-2xl sm:text-3xl text-bay-white mb-3 leading-tight">
          Recent reviews.
        </h2>
        <p class="text-bay-slate text-base max-w-2xl leading-relaxed">
          Reviews load live from the source. If they are slow to appear, your
          browser may be blocking the review widget script.
        </p>
      </div>

      {featurableId ? (
        <>
          <div class="featurable-widget" data-widget-id={featurableId}></div>
          <script src="https://cdn.featurable.com/assets/widget/v1/featurable-widget.min.js" async is:inline></script>
        </>
      ) : (
        <div class="reveal border-l-2 border-bay-gold pl-5 py-2">
          <p class="text-bay-bone text-base leading-relaxed mb-2">
            Reviews aggregation is being connected to this page.
          </p>
          <p class="text-bay-slate text-sm leading-relaxed">
            In the meantime, search <span class="font-mono text-bay-bone">BayShine Detailing</span> on
            Google to read current customer reviews directly on the Google
            Business Profile.
          </p>
          {/* FOLLOWUP: src/pages/reviews.astro — Once a Google Business Profile
              place ID is confirmed, replace the search-instruction copy with a
              direct link to the GBP reviews surface (g.page/r/<place-id>/review). */}
        </div>
      )}
    </div>
  </section>

  <Divider />

  <!-- ── FAQ (reviews-relevant questions) ───────────────────── -->
  <section id="faq" class="py-20 px-4 scroll-mt-20">
    <div class="container mx-auto max-w-3xl">
      <div class="reveal mb-10">
        <p class="text-bay-gold text-xs font-semibold uppercase tracking-widest mb-4">What clients ask most</p>
        <h2 class="font-display font-bold text-3xl text-bay-white leading-tight">
          The questions behind the reviews.
        </h2>
        <p class="text-bay-slate text-base leading-relaxed mt-6 max-w-2xl">
          The questions a prospect typically has after reading other people's
          experiences. Direct answers, no hedging.
        </p>
      </div>

      <dl class="reveal space-y-8">
        {allFaqs.map(item => (
          <div class="border-l-2 border-bay-gold/40 pl-5">
            <dt class="font-display font-semibold text-bay-white text-base mb-3">{item.question}</dt>
            <dd class="text-bay-slate text-sm leading-relaxed">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Divider />

  <!-- ── SERVING WHERE / CONTEXT ────────────────────────────── -->
  <section class="noise-overlay section-bevel bg-bay-deep py-16 px-4">
    <div class="container mx-auto max-w-3xl">
      <div class="reveal">
        <p class="text-bay-gold text-xs font-semibold uppercase tracking-widest mb-4">Where these reviews come from</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-bay-white mb-6 leading-tight">
          One operator, one market, one standard.
        </h2>
        <p class="text-bay-bone text-base leading-relaxed mb-6">
          BayShine is a mobile auto detailing operation based in Land O' Lakes,
          Florida, serving Pasco County and North Hillsborough. Every detail
          happens at the client's location: driveway, parking lot, workplace.
          Every appointment is a single vehicle. The reviews on this page come
          from those appointments.
        </p>
        <p class="text-bay-slate text-base leading-relaxed">
          More on how the work is done: <a href="/about" class="text-bay-gold hover:text-[#d9bc79] underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">the methodology</a> ·
          <a href="/standing-detail" class="text-bay-gold hover:text-[#d9bc79] underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm">the Standing Detail program</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ──────────────────────────────────────────── -->
  <section class="noise-overlay bg-bay-deep py-20 px-4">
    <div class="container mx-auto max-w-2xl text-center">
      <div class="reveal">
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-bay-white mb-4">
          Ready to book?
        </h2>
        <p class="text-bay-slate mb-8 leading-relaxed">
          Book online or call. Response within 2 hours during business hours.
        </p>
        <div class="flex flex-wrap gap-4 justify-center items-center">
          <Button href="/contact" variant="primary" class="text-base px-8 py-3.5">
            Book Now
          </Button>
          <a
            href="tel:+18133245522"
            class="inline-flex items-center gap-2 text-bay-gold font-display font-semibold text-base hover:text-[#d9bc79] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bay-gold rounded-sm"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 13.5 19.79 19.79 0 0 1 1.07 4.9 2 2 0 0 1 3.05 2.74h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 18z"/>
            </svg>
            (813) 324-5522
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
